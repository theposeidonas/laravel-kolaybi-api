{
    "name": "theposeidonas/laravel-kolaybi-api",
    "description": "KolayBi API for Laravel Projects",
    "keywords": [
        "laravel",
        "kolaybi",
        "invoice",
        "e-invoice",
        "e-fatura",
        "billing",
        "accounting"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Baran Arda",
            "email": "baran@webremium.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Theposeidonas\\Kolaybi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Theposeidonas\\Kolaybi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Theposeidonas\\Kolaybi\\KolaybiServiceProvider"
            ],
            "aliases": {
                "Kolaybi": "Theposeidonas\\Kolaybi\\Facades\\Kolaybi"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "prefer-stable": true
}
